# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# On Netlify / Vercel add the SAME variables under Site settings → Environment
# variables, then redeploy.
#
# Write values as KEY=value — no spaces around "=", no quotes needed.
# ---------------------------------------------------------------------------

# --- MongoDB (Atlas) --------------------------------------------------------
# Atlas → your cluster → Connect → Drivers → copy the connection string and put
# your database user's password in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=portfolio
MONGODB_DB=portfolio

# --- Dashboard login --------------------------------------------------------
# The admin account is defined here (not in the database), so you can always
# sign in even if the database has a problem. Change these any time and
# restart / redeploy.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
# Random secret used to sign the login cookie (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Only needed once, to import your old data from Supabase ----------------
# (npm run import:supabase — see scripts/import-supabase.mjs)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-publishable-key
# SUPABASE_EMAIL=old-dashboard-login-email
# SUPABASE_PASSWORD=old-dashboard-login-password
