# ---------------------------------------------------------------------------
# Supabase configuration
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard: Project Settings -> API
#
# IMPORTANT: no spaces around the "=" and no leading space before the value.
#   Correct:   NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
#   Wrong:     NEXT_PUBLIC_SUPABASE_URL= https://xxxx.supabase.co   <- stray space
# ---------------------------------------------------------------------------

# Public project URL (looks like https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public key — the "anon" key (eyJ...) OR the new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Site (use your real deployed URL in production)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
